{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-dev",
      "displayName": "桌面开发构建",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "桌面发行构建",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "core-dev",
      "displayName": "无界面核心开发构建",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "XUYANFORGE_BUILD_UI": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-dev", "configurePreset": "windows-dev" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "core-dev", "configurePreset": "core-dev" }
  ],
  "testPresets": [
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "core-dev",
      "configurePreset": "core-dev",
      "output": { "outputOnFailure": true }
    }
  ]
}
